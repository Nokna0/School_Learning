# 이 파일을 복사해서 사용하세요.
#   Docker:  cp .env.example .env
#   직접 실행: cp .env.example .env.local
# 실제 키가 든 .env / .env.local 은 .gitignore 로 커밋되지 않습니다.

# ==================== 서버 ====================
NODE_ENV=development
PORT=3000

# 허용할 프론트엔드 오리진 (dev: 5173 / docker: 8080)
CORS_ORIGIN=http://localhost:5173

# true 로 두면 x-user-id 헤더 또는 edutech_uid 쿠키가 있어야 인증됩니다.
# 비워두면 로그인 없이 로컬 기본 사용자(local-user)로 동작합니다.
REQUIRE_AUTH=

# ==================== 클라이언트 (VITE_ 접두사만 번들에 주입됨) ====================
VITE_APP_TITLE=EduTech
VITE_API_URL=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# ==================== 데이터베이스 (MySQL) ====================
# 자료 업로드 / 학습 기록 기능에 필요합니다.
DATABASE_URL=mysql://edutech:edutech@localhost:3306/edutech

# docker compose 로 MySQL을 띄울 때만 사용 (compose 기본값과 동일)
MYSQL_DATABASE=edutech
MYSQL_USER=edutech
MYSQL_PASSWORD=edutech
MYSQL_ROOT_PASSWORD=root

# ==================== AI 공급자 ====================
# openai(기본) | google | anthropic | ollama
# 미설정 시 AI 엔드포인트는 예시(mock) 응답을 반환합니다.
AI_PROVIDER=openai

# 공급자 공통 모델 오버라이드 (비워두면 공급자별 기본 모델 사용)
AI_MODEL=

# --- openai (기본 모델: gpt-4o-mini) ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# --- google / gemini (기본 모델: gemini-2.5-flash) ---
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_MODEL=

# --- anthropic (기본 모델: claude-opus-4-8) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- ollama: 로컬 GPU 사용, API 키 불필요 ---
# Docker에서는 host.docker.internal 로 호스트의 Ollama에 접속합니다.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_API_KEY=

# ==================== Cloudinary (PDF 업로드) ====================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
